# ============================================================
# AI CMO, environment variables
# ============================================================
# Copy this file to .env and fill in what you need.
# The stub loop (python run.py "...") needs NONE of these.
# Each var is read by a specific station. Vars marked
# [NOT WIRED YET] are the target seam for a station that is
# still a stub: setting the key does nothing until the builder
# wires the gate. The full picture is docs/BUILD-TARGET.md.
# ============================================================

# ---- Station 1, Brain (Think + Write) -----------------------
ANTHROPIC_API_KEY=            # Claude generation for the /ai-cmo-generate command. The offline engine needs no key. [used by the command, not the engine]

# ---- Station 2, Studio (Design + Check) ---------------------
# AICMO_RENDER=playwright     # Selector: which render backend to use (playwright | placid | gemini). [NOT WIRED YET]
GEMINI_API_KEY=               # Optional image-model render path (gemini_direct). [NOT WIRED YET]
PLACID_API_TOKEN=             # Placid template composite render. [NOT WIRED YET]
PLACID_TEMPLATE_UUID=         # Default Placid template uuid (image/headline/subhead/cta/wordmark slots). [NOT WIRED YET]
# AICMO_VISION_QC=claude      # Selector: turn on Claude vision brand QC (pass/borderline/fail). [NOT WIRED YET]

# ---- Station 3, Mission (Gate + Ship + Measure) -------------
ZERNIO_API_KEY=               # Single publish layer (LinkedIn, Instagram) + analytics pull. [NOT WIRED YET]

# ---- Station 4, Ads (recommend-only) ------------------------
# Canonical names. The code does not read these yet: the builder
# adds the env gate when wiring the real campaign push.
META_ACCESS_TOKEN=            # Meta ad campaigns. [NOT WIRED YET]
LINKEDIN_ACCESS_TOKEN=        # LinkedIn ad campaigns. [NOT WIRED YET]

# ---- Client surface, Notion (human gate + dashboard) -------
NOTION_TOKEN=                 # Notion API token. WIRED: provision + push/pull.
NOTION_PARENT_PAGE_ID=        # Page to create the Content Pipeline database under. WIRED (required to go live).
NOTION_BRIEFS_DB_ID=          # Weekly Briefs database for reporting (weekly_brief). [NOT WIRED YET]

# ---- Analytics / SEO / GEO (DataOS collectors, daily 06:00) -
GA4_PROPERTY_ID=526918509     # Google Analytics 4 property (collect_ga, 06:00). [NOT WIRED YET]
GOOGLE_OAUTH_CLIENT_ID=       # OAuth2 for the GA4 + GSC collectors. [NOT WIRED YET]
GOOGLE_OAUTH_CLIENT_SECRET=   # [NOT WIRED YET]
GOOGLE_OAUTH_REFRESH_TOKEN=   # [NOT WIRED YET]
GSC_SITE_URL=                 # Google Search Console property, e.g. https://client.com/ (collect_gsc, 06:15). [NOT WIRED YET]
DATAFORSEO_LOGIN=             # DataForSEO ranks + AIO (collect_geo, Mon 07:45, cap $5). Pay-as-you-go. [NOT WIRED YET]
DATAFORSEO_PASSWORD=          # Paired with DATAFORSEO_LOGIN. [NOT WIRED YET]
STRIPE_API_KEY=               # Stripe MRR for the client dashboard (collect_stripe). [NOT WIRED YET]

# ---- Reporting / ops ----------------------------------------
TELEGRAM_BOT_TOKEN=           # portfolio_digest weekly digest to Telegram (Mon 08:00). [NOT WIRED YET]
TELEGRAM_CHAT_ID=             # Telegram chat or channel id the digest posts to. [NOT WIRED YET]
