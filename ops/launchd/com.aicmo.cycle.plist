<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.aicmo.cycle</string>

    <!-- Run every 30 minutes (1800 seconds) -->
    <key>StartInterval</key>
    <integer>1800</integer>

    <key>ProgramArguments</key>
    <array>
        <!-- Replace with: $(python3 -c "import sys; print(sys.executable)") from the repo root -->
        <string>/opt/homebrew/bin/python3</string>
        <string>-m</string>
        <string>engine.cron</string>
        <string>cycle</string>
        <string>--client</string>
        <string>lumen-skin</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/short/Downloads/aicmo-core</string>

    <key>StandardOutPath</key>
    <string>/Users/short/Downloads/aicmo-core/outputs/logs/cycle.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/short/Downloads/aicmo-core/outputs/logs/cycle.log</string>

    <key>RunAtLoad</key>
    <false/>

    <key>KeepAlive</key>
    <false/>
</dict>
</plist>
